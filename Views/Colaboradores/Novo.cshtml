@model CollaboratorFormViewModel
@using Automind.CadastroColaboradores.Models
@{
    ViewData["Title"] = "Novo colaborador";
    var ous = ViewBag.Ous as IReadOnlyList<OrganizationalUnitOption> ?? [];
    var adReadError = ViewBag.AdReadError as string;
    var adGroupError = ViewBag.AdGroupError as string;
    var writeMode = ViewBag.AdWriteMode is bool enabled && enabled;
    var adMode = ViewBag.AdMode as string ?? "ReadOnly";
    var groupWritesEnabled = ViewBag.AdGroupWritesEnabled is bool groupsEnabled && groupsEnabled;
    var writeAllowedOuDns = ViewBag.WriteAllowedOuDns as IReadOnlyList<string> ?? [];
    var writeTargetOu = writeAllowedOuDns.FirstOrDefault() ?? string.Empty;
    var commonCount = Model.GruposSugeridos.Count(g => !g.Protegido && g.EncontradoEm == g.TotalComparados);
    var exceptionCount = Model.GruposSugeridos.Count(g => !g.Protegido && g.EncontradoEm != g.TotalComparados);
    var protectedCount = Model.GruposSugeridos.Count(g => g.Protegido);
}

<div class="app-container content-stack page-enter">
    <section class="page-heading">
        <div>
            <span class="eyebrow">PROVISIONAMENTO</span>
            <h1>Novo colaborador</h1>
            <p>Revise os dados, consulte o Active Directory e valide a prévia antes de qualquer operação de escrita.</p>
        </div>
        <span class="badge-readonly">AD REAL · @(writeMode ? "PILOTO CONTROLADO" : "SOMENTE LEITURA")</span>
    </section>

    <div class="safe-banner @(writeMode ? "safe-banner-pilot" : string.Empty)">
        <div class="safe-banner-icon">✓</div>
        <div>
            @if (writeMode)
            {
                <strong>Piloto de escrita ativo apenas no escopo autorizado.</strong>
                <span>Criação permitida somente na OU piloto. Grupos, proxyAddresses, pwdLastSet e Microsoft 365 permanecem bloqueados.</span>
            }
            else
            {
                <strong>Consultas reais ao Active Directory; escrita bloqueada.</strong>
                <span>O código de provisionamento está preparado, mas <code>Automind:Mode=@adMode</code> mantém toda criação de usuário bloqueada.</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(adReadError))
    {
        <div class="topdesk-import-status is-error">@adReadError</div>
    }
    @if (!string.IsNullOrWhiteSpace(adGroupError))
    {
        <div class="topdesk-import-status is-error">@adGroupError</div>
    }

    <section class="panel source-panel">
        <div class="source-copy">
            <span class="eyebrow">ORIGEM DA SOLICITAÇÃO</span>
            <h2>Chamado TOPdesk</h2>
            <p>Todo cadastro deve estar vinculado a um chamado. Para o formulário estruturado, importe os dados pela extensão Automind TOPdesk Bridge.</p>
        </div>
        <form class="source-controls" method="post" data-topdesk-import data-import-url='@Url.Action("ImportarTopdesk", "Colaboradores")'>
            @Html.AntiForgeryToken()
            <div class="field compact-field">
                <label>Número do chamado</label>
                <div class="ticket-input-wrap compact-ticket">
                    <span class="ticket-prefix">#</span>
                    <input name="chamado" data-ticket-source value="@Model.Chamado" placeholder="I2609-0223" autocomplete="off" />
                </div>
            </div>
            <div class="field compact-field source-field">
                <label>Fonte</label>
                <input value="@Model.Fonte" readonly />
            </div>
            <button type="submit" class="btn btn-primary">Carregar TOPdesk</button>
        </form>
        <div class="source-extension-help">
            Para carregar chamados, a extensão <strong>Automind TOPdesk Bridge</strong> precisa estar instalada no navegador.
            <a href="/ajuda/extensao-topdesk.html" target="_blank" rel="noopener">Ver instalação</a>
        </div>
        <div class="topdesk-import-status" data-topdesk-status hidden></div>
    </section>

    <form class="provisioning-grid"
          data-provisioning-form
          data-groups-url='@Url.Action("BuscarGrupos", "Colaboradores")'
          data-validation-url='@Url.Action("ValidarAd", "Colaboradores")'
          data-create-url='@Url.Action("CriarUsuarioPiloto", "Colaboradores")'
          data-write-enabled="@writeMode.ToString().ToLowerInvariant()"
          data-write-target-ou="@writeTargetOu"
          data-group-writes-enabled="@groupWritesEnabled.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Chamado" value="@Model.Chamado" />
        <input type="hidden" name="PerfilUsuario" value="@Model.PerfilUsuario" />
        <input type="hidden" name="GrupoTrabalho" value="@Model.GrupoTrabalho" />

        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">01</div>
                <div><span class="eyebrow">IDENTIFICAÇÃO</span><h2>Dados do colaborador</h2></div>
            </div>

            <div class="field"><label>Nome completo</label><input name="NomeCompleto" value="@Model.NomeCompleto" /></div>
            <div class="field"><label>Nome de guerra <small>exatamente 2 nomes</small></label><input name="NomeGuerra" value="@Model.NomeGuerra" /></div>
            <div class="form-row-2">
                <div class="field"><label>Login</label><input name="Login" value="@Model.Login" /></div>
                <div class="field"><label>E-mail corporativo</label><input name="Email" value="@Model.Email" /></div>
            </div>
            <div class="form-row-2">
                <div class="field">
                    <label>Telefone celular <small>formato: (71) 9 8169-6721</small></label>
                    <input name="TelefoneCelular"
                           value="@Model.TelefoneCelular"
                           data-phone-br
                           inputmode="numeric"
                           autocomplete="tel"
                           maxlength="16"
                           placeholder="(71) 9 8169-6721" />
                </div>
                <div class="field"><label>Local de trabalho</label><input name="LocalTrabalho" value="@Model.LocalTrabalho" /></div>
            </div>
            <label class="toggle-line">
                <input name="DivulgarContato" type="checkbox" checked="@Model.DivulgarContato" />
                <span class="toggle-ui"></span>
                <span><strong>Divulgar contato na intranet</strong><small>O telefone só será gravado no AD quando esta opção estiver ativa.</small></span>
            </label>
        </section>

        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">02</div>
                <div><span class="eyebrow">ORGANIZAÇÃO</span><h2>Cargo e estrutura</h2></div>
            </div>

            <div class="field"><label>Cargo em português</label><input name="CargoPortugues" value="@Model.CargoPortugues" /></div>
            <div class="field"><label>Cargo em inglês</label><input name="CargoIngles" value="@Model.CargoIngles" /></div>
            <div class="form-row-2">
                <div class="field"><label>Departamento</label><input name="Departamento" value="@Model.Departamento" /></div>
                <div class="field"><label>Empresa</label><input name="Empresa" value="Automind" readonly /></div>
            </div>
            <div class="field"><label>Superior imediato</label><input name="SuperiorImediato" value="@Model.SuperiorImediato" /></div>
            <div class="field">
                <label>OU de destino</label>
                <select name="OuDistinguishedName">
                    <option value="">Selecione uma OU...</option>
                    @foreach (var ou in ous)
                    {
                        <option value="@ou.DistinguishedName" selected="@(string.Equals(Model.OuSelecionada, ou.DistinguishedName, StringComparison.OrdinalIgnoreCase))">@ou.DisplayName</option>
                    }
                </select>
                <small class="field-help">Opções consultadas no AD real e filtradas pela allowlist de leitura. A escrita possui allowlist separada.</small>
            </div>
        </section>

        <section class="panel access-panel span-full">
            <div class="access-heading">
                <div>
                    <span class="eyebrow">03 · ACESSOS</span>
                    <h2>Sugestão automática pelo cargo</h2>
                    <p>A aplicação consulta usuários ativos com o mesmo cargo + departamento e calcula a frequência dos grupos diretos <code>memberOf</code>.</p>
                </div>
                <div class="access-tools">
                    <button type="button" class="btn btn-secondary" data-search-groups>Buscar grupos no AD</button>
                    <button type="button" class="btn btn-secondary" disabled title="A busca por colaborador de referência será habilitada em etapa posterior.">Colaborador de referência</button>
                </div>
            </div>

            <div class="empty-state" data-groups-empty hidden="@(Model.GruposSugeridos.Count > 0)">
                <span class="empty-state-icon">◎</span>
                <div><strong>Nenhuma sugestão carregada</strong><p>Informe cargo em inglês e departamento e clique em Buscar grupos no AD.</p></div>
            </div>

            <div class="access-summary" data-groups-summary hidden="@(Model.GruposSugeridos.Count == 0)">
                <div><strong data-common-count>@commonCount</strong><span>comuns ao cargo</span></div>
                <div><strong data-exception-count>@exceptionCount</strong><span>exceções encontradas</span></div>
                <div><strong data-protected-count>@protectedCount</strong><span>grupos protegidos</span></div>
            </div>
            <div class="table-wrap" data-groups-table hidden="@(Model.GruposSugeridos.Count == 0)">
                <table class="access-table">
                    <thead><tr><th></th><th>Grupo</th><th>Incidência</th><th>Classificação</th></tr></thead>
                    <tbody data-groups-body>
                    @foreach (var g in Model.GruposSugeridos)
                    {
                        var comum = !g.Protegido && g.EncontradoEm == g.TotalComparados;
                        <tr class="@(g.Protegido ? "row-protected" : comum ? "row-common" : "")">
                            <td><input class="group-checkbox" type="checkbox" value="@g.DistinguishedName" checked="@g.Selecionado" disabled="@g.Protegido" /></td>
                            <td>
                                <strong>@g.Nome</strong>
                                <small class="group-meta">@g.Categoria · @g.Escopo</small>
                                @if (g.EfeitosIndiretos.Count > 0)
                                {
                                    <small class="group-indirect">Acesso indireto: @string.Join(", ", g.EfeitosIndiretos)</small>
                                }
                            </td>
                            <td><span class="incidence">@g.EncontradoEm / @g.TotalComparados</span></td>
                            <td>
                                @if (g.Protegido)
                                {
                                    <span class="status-pill status-pill-danger">Protegido</span>
                                }
                                else if (comum)
                                {
                                    <span class="status-pill status-pill-success">Comum ao cargo</span>
                                }
                                else
                                {
                                    <span class="status-pill">Exceção</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (!groupWritesEnabled)
            {
                <div class="topdesk-import-status is-warning group-write-warning">A sugestão de grupos continua disponível para revisão, mas o piloto não grava memberships. Para criar o usuário piloto, deixe todos os grupos desmarcados.</div>
            }
            <div class="topdesk-import-status" data-groups-status hidden></div>
        </section>

        <section class="panel validation-panel span-full">
            <div class="validation-copy">
                <span class="eyebrow">04 · PRÉ-VALIDAÇÃO</span>
                <h2>Validar no AD</h2>
                <p>Revalida chamado, identidade, superior, OU e grupos diretamente no backend. Microsoft 365 não participa desta etapa.</p>
            </div>
            <div class="validation-checks">
                <span data-ad-check="ticket">○ Chamado TOPdesk válido</span>
                <span data-ad-check="name">○ Nome completo válido</span>
                <span data-ad-check="login">○ Login válido e disponível</span>
                <span data-ad-check="cn">○ CN disponível na OU</span>
                <span data-ad-check="upn">○ UPN disponível</span>
                <span data-ad-check="email">○ E-mail / SMTP disponível</span>
                <span data-ad-check="organization">○ Cargo e departamento preenchidos</span>
                <span data-ad-check="manager">○ Superior localizado</span>
                <span data-ad-check="ou">○ OU válida</span>
                <span data-ad-check="groups">○ Grupos válidos</span>
            </div>
            <div class="validation-actions">
                <button type="button" class="btn btn-primary btn-wide" data-validate-ad>Validar no AD <small>somente leitura</small></button>
            </div>
            <div class="topdesk-import-status validation-status" data-validation-status hidden></div>
        </section>

        <section class="panel span-full ad-preview" data-ad-preview hidden>
            <div class="section-title-row">
                <div class="section-number">05</div>
                <div><span class="eyebrow">PRÉVIA</span><h2>Objeto preparado para o AD</h2></div>
            </div>
            <p class="preview-warning"><strong>A prévia não executa escrita.</strong> proxyAddresses e pwdLastSet permanecem fora do contrato do piloto.</p>
            <dl class="preview-grid">
                <div><dt>CN</dt><dd data-preview="cn"></dd></div>
                <div><dt>sAMAccountName</dt><dd data-preview="samAccountName"></dd></div>
                <div><dt>givenName</dt><dd data-preview="givenName"></dd></div>
                <div><dt>sn</dt><dd data-preview="surname"></dd></div>
                <div><dt>UPN</dt><dd data-preview="userPrincipalName"></dd></div>
                <div><dt>mail</dt><dd data-preview="mail"></dd></div>
                <div><dt>description</dt><dd data-preview="description"></dd></div>
                <div><dt>SMTP futuro (não escrito)</dt><dd data-preview="primarySmtp"></dd></div>
                <div><dt>SMTP secundário futuro (não escrito)</dt><dd data-preview="secondarySmtp"></dd></div>
                <div><dt>Title</dt><dd data-preview="title"></dd></div>
                <div><dt>Department</dt><dd data-preview="department"></dd></div>
                <div><dt>Company</dt><dd data-preview="company"></dd></div>
                <div><dt>Office</dt><dd data-preview="office"></dd></div>
                <div><dt>Telephone</dt><dd data-preview="telephoneNumber"></dd></div>
                <div class="preview-wide"><dt>Manager DN</dt><dd data-preview="managerDistinguishedName"></dd></div>
                <div class="preview-wide"><dt>OU DN</dt><dd data-preview="ouDistinguishedName"></dd></div>
                <div class="preview-wide"><dt>Grupos selecionados</dt><dd data-preview="groups"></dd></div>
            </dl>
        </section>

        @if (writeMode)
        {
            <section class="panel span-full pilot-write-panel" data-pilot-write>
                <div class="section-title-row">
                    <div class="section-number">06</div>
                    <div><span class="eyebrow">PILOTO CONTROLADO</span><h2>Criar usuário no AD</h2></div>
                </div>
                <div class="pilot-scope">
                    <strong>Escopo de escrita:</strong>
                    <code>@writeTargetOu</code>
                </div>
                <p>O backend reexecuta todas as validações imediatamente antes da escrita. A conta nasce desabilitada, recebe atributos, senha e manager, é relida e só então é habilitada. Grupos, M365, proxyAddresses e pwdLastSet permanecem bloqueados.</p>
                <button type="button" class="btn btn-primary btn-wide" data-create-user disabled>Criar usuário piloto no AD</button>
                <div class="topdesk-import-status" data-create-status hidden></div>
                <div class="temporary-password" data-temporary-password hidden>
                    <strong>Senha inicial — exibição única</strong>
                    <code data-password-value></code>
                    <button type="button" class="btn btn-secondary" data-copy-password>Copiar senha</button>
                    <small>Não registrar esta senha em histórico, banco, ticket ou log.</small>
                </div>
            </section>
        }
    </form>
</div>
