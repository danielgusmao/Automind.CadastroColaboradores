@model CollaboratorFormViewModel
@{
    ViewData["Title"] = "Novo colaborador";
    var ous = ViewBag.Ous as IReadOnlyList<string> ?? [];
}

<div class="app-container content-stack page-enter">
    <section class="page-heading">
        <div>
            <span class="eyebrow">PROVISIONAMENTO</span>
            <h1>Novo colaborador</h1>
            <p>Revise os dados, valide o ambiente e confirme os acessos antes de qualquer operação futura.</p>
        </div>
        <span class="badge-readonly">FASE 1 · SOMENTE LEITURA</span>
    </section>

    <div class="safe-banner">
        <div class="safe-banner-icon">✓</div>
        <div>
            <strong>Ambiente protegido contra alterações.</strong>
            <span>Esta tela não cria usuários, não altera grupos, não redefine senhas e não atribui licenças.</span>
        </div>
    </div>

    <section class="panel source-panel">
        <div class="source-copy">
            <span class="eyebrow">ORIGEM DA SOLICITAÇÃO</span>
            <h2>Chamado TOPdesk</h2>
            <p>O formulário ficará editável após a importação para permitir conferência antes das validações.</p>
        </div>
        <div class="source-controls">
            <div class="field compact-field">
                <label>Número do chamado</label>
                <div class="ticket-input-wrap compact-ticket">
                    <span class="ticket-prefix">#</span>
                    <input value="@Model.Chamado" placeholder="I2609-0223" />
                </div>
            </div>
            <div class="field compact-field source-field">
                <label>Fonte</label>
                <input value="@Model.Fonte" readonly />
            </div>
            <button type="button" class="btn btn-primary">Carregar TOPdesk</button>
        </div>
    </section>

    <form class="provisioning-grid">
        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">01</div>
                <div><span class="eyebrow">IDENTIFICAÇÃO</span><h2>Dados do colaborador</h2></div>
            </div>

            <div class="field"><label>Nome completo</label><input value="@Model.NomeCompleto" /></div>
            <div class="field"><label>Nome de guerra <small>exatamente 2 nomes</small></label><input value="@Model.NomeGuerra" /></div>
            <div class="form-row-2">
                <div class="field"><label>Login</label><input value="@Model.Login" /></div>
                <div class="field"><label>E-mail corporativo</label><input value="@Model.Email" /></div>
            </div>
            <div class="form-row-2">
                <div class="field"><label>Telefone celular</label><input value="@Model.TelefoneCelular" /></div>
                <div class="field"><label>Local de trabalho</label><input value="@Model.LocalTrabalho" /></div>
            </div>
            <label class="toggle-line">
                <input type="checkbox" checked="@Model.DivulgarContato" />
                <span class="toggle-ui"></span>
                <span><strong>Divulgar contato na intranet</strong><small>O telefone só será considerado para publicação quando esta opção estiver ativa.</small></span>
            </label>
        </section>

        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">02</div>
                <div><span class="eyebrow">ORGANIZAÇÃO</span><h2>Cargo e estrutura</h2></div>
            </div>

            <div class="field"><label>Cargo em português</label><input value="@Model.CargoPortugues" /></div>
            <div class="field"><label>Cargo em inglês</label><input value="@Model.CargoIngles" /></div>
            <div class="form-row-2">
                <div class="field"><label>Departamento</label><input value="@Model.Departamento" /></div>
                <div class="field"><label>Empresa</label><input value="Automind" readonly /></div>
            </div>
            <div class="field"><label>Superior imediato</label><input value="@Model.SuperiorImediato" /></div>
            <div class="field">
                <label>OU de destino</label>
                <select>
                    <option value="">Selecione uma OU...</option>
                    @foreach (var ou in ous)
                    {
                        <option>@ou</option>
                    }
                </select>
                <small class="field-help">A lista definitiva será lida diretamente do Active Directory.</small>
            </div>
        </section>

        <section class="panel access-panel span-full">
            <div class="access-heading">
                <div>
                    <span class="eyebrow">03 · ACESSOS</span>
                    <h2>Sugestão automática pelo cargo</h2>
                    <p>Comparamos colaboradores ativos com o mesmo cargo/departamento e destacamos o que é comum a todos.</p>
                </div>
                <div class="access-tools">
                    <button type="button" class="btn btn-secondary">Buscar grupos</button>
                    <button type="button" class="btn btn-secondary">Usar colaborador de referência</button>
                </div>
            </div>

            @if (Model.GruposSugeridos.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-state-icon">◎</span>
                    <div><strong>Nenhuma sugestão carregada</strong><p>Carregue um chamado ou informe cargo e departamento para iniciar a comparação.</p></div>
                </div>
            }
            else
            {
                <div class="access-summary">
                    <div><strong>@Model.GruposSugeridos.Count(g => !g.Protegido && g.EncontradoEm == g.TotalComparados)</strong><span>comuns ao cargo</span></div>
                    <div><strong>@Model.GruposSugeridos.Count(g => !g.Protegido && g.EncontradoEm != g.TotalComparados)</strong><span>exceções encontradas</span></div>
                    <div><strong>@Model.GruposSugeridos.Count(g => g.Protegido)</strong><span>grupos protegidos</span></div>
                </div>
                <div class="table-wrap">
                    <table class="access-table">
                        <thead><tr><th></th><th>Grupo</th><th>Incidência</th><th>Classificação</th></tr></thead>
                        <tbody>
                        @foreach (var g in Model.GruposSugeridos)
                        {
                            var comum = !g.Protegido && g.EncontradoEm == g.TotalComparados;
                            <tr class="@(g.Protegido ? "row-protected" : comum ? "row-common" : "")">
                                <td><input type="checkbox" checked="@g.Selecionado" disabled="@g.Protegido" /></td>
                                <td><strong>@g.Nome</strong></td>
                                <td><span class="incidence">@g.EncontradoEm / @g.TotalComparados</span></td>
                                <td>
                                    @if (g.Protegido)
                                    {
                                        <span class="status-pill status-pill-danger">Protegido</span>
                                    }
                                    else if (comum)
                                    {
                                        <span class="status-pill status-pill-success">Comum ao cargo</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill">Exceção</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel validation-panel span-full">
            <div class="validation-copy">
                <span class="eyebrow">04 · PRÉ-VALIDAÇÃO</span>
                <h2>Validar antes de criar</h2>
                <p>O botão abaixo será usado apenas para consultas e checagens enquanto a escrita permanecer bloqueada.</p>
            </div>
            <div class="validation-checks">
                <span>○ Login disponível</span>
                <span>○ UPN / e-mail disponível</span>
                <span>○ Superior localizado</span>
                <span>○ OU válida</span>
                <span>○ Grupos existentes</span>
                <span>○ Licenças M365 disponíveis</span>
            </div>
            <div class="validation-actions">
                <button type="button" class="btn btn-primary btn-wide">Validar no AD <small>somente leitura</small></button>
            </div>
        </section>
    </form>
</div>
