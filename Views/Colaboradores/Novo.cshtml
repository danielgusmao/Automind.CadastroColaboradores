@model CollaboratorFormViewModel
@using Automind.CadastroColaboradores.Models
@{
    ViewData["Title"] = "Novo colaborador";
    var ous = ViewBag.Ous as IReadOnlyList<OrganizationalUnitOption> ?? [];
    var adReadError = ViewBag.AdReadError as string;
    var adGroupError = ViewBag.AdGroupError as string;
    var writeMode = ViewBag.AdWriteMode is bool enabled && enabled;
    var adMode = ViewBag.AdMode as string ?? "ReadOnly";
    var groupWritesEnabled = ViewBag.AdGroupWritesEnabled is bool groupsEnabled && groupsEnabled;
    var pilotMembershipTestEnabled = ViewBag.PilotMembershipTestEnabled is bool membershipEnabled && membershipEnabled;
    var pilotMembershipUserDn = ViewBag.PilotMembershipUserDn as string ?? string.Empty;
    var pilotMembershipGroupDn = ViewBag.PilotMembershipGroupDn as string ?? string.Empty;
    var writeAllowedOuDns = ViewBag.WriteAllowedOuDns as IReadOnlyList<string> ?? [];
    var writeTargetOu = writeAllowedOuDns.FirstOrDefault() ?? string.Empty;
    var microsoft365Enabled = ViewBag.Microsoft365Enabled is bool m365Enabled && m365Enabled;
    var microsoft365LicenseWritesEnabled = ViewBag.Microsoft365LicenseWritesEnabled is bool m365Writes && m365Writes;
    var microsoft365Licenses = ViewBag.Microsoft365Licenses as IReadOnlyList<Microsoft365LicenseInfo> ?? [];
    var microsoft365Error = ViewBag.Microsoft365Error as string;
    var microsoft365SyncPollSeconds = ViewBag.Microsoft365SyncPollSeconds is int pollSeconds ? pollSeconds : 10;
    var microsoft365SyncMaxWaitSeconds = ViewBag.Microsoft365SyncMaxWaitSeconds is int maxWaitSeconds ? maxWaitSeconds : 180;
    var microsoft365Healthy = microsoft365Enabled && string.IsNullOrWhiteSpace(microsoft365Error);
    var commonGroups = Model.GruposSugeridos.Where(g => !g.Protegido && g.TotalComparados > 0 && g.EncontradoEm == g.TotalComparados).ToList();
    var exceptionGroups = Model.GruposSugeridos.Where(g => !g.Protegido && (g.TotalComparados == 0 || g.EncontradoEm != g.TotalComparados)).ToList();
    var protectedGroups = Model.GruposSugeridos.Where(g => g.Protegido).ToList();
    var commonCount = commonGroups.Count;
    var exceptionCount = exceptionGroups.Count;
    var protectedCount = protectedGroups.Count;
}

<div class="app-container content-stack page-enter">
    <section class="page-heading">
        <div>
            <span class="eyebrow">PROVISIONAMENTO</span>
            <h1>Novo colaborador</h1>
            <p>Revise os dados, consulte o Active Directory e valide a prévia antes de qualquer operação de escrita.</p>
        </div>
        <span class="badge-readonly">AD REAL · @(writeMode ? "PILOTO CONTROLADO" : "SOMENTE LEITURA")</span>
    </section>

    <div class="safe-banner @(writeMode ? "safe-banner-pilot" : string.Empty)">
        <div class="safe-banner-icon">✓</div>
        <div>
            @if (writeMode)
            {
                <strong>Piloto de escrita ativo apenas no escopo autorizado.</strong>
                <span>Criação permitida somente na OU piloto. Memberships seguem a allowlist de escrita; licenças Microsoft 365 disponíveis podem ser selecionadas e são atribuídas somente após o usuário sincronizar com o Entra.</span>
            }
            else
            {
                <strong>Consultas reais ao Active Directory; escrita bloqueada.</strong>
                <span>O código de provisionamento está preparado, mas <code>Automind:Mode=@adMode</code> mantém toda criação de usuário bloqueada.</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(adReadError))
    {
        <div class="topdesk-import-status is-error">@adReadError</div>
    }
    @if (!string.IsNullOrWhiteSpace(adGroupError))
    {
        <div class="topdesk-import-status is-error">@adGroupError</div>
    }

    <section class="panel source-panel">
        <div class="source-copy">
            <span class="eyebrow">ORIGEM DA SOLICITAÇÃO</span>
            <h2>Chamado TOPdesk</h2>
            <p>Todo cadastro deve estar vinculado a um chamado. Para o formulário estruturado, importe os dados pela extensão Automind TOPdesk Bridge.</p>
        </div>
        <form class="source-controls" method="post" data-topdesk-import data-import-url='@Url.Action("ImportarTopdesk", "Colaboradores")'>
            @Html.AntiForgeryToken()
            <div class="field compact-field">
                <label>Número do chamado</label>
                <div class="ticket-input-wrap compact-ticket">
                    <span class="ticket-prefix">#</span>
                    <input name="chamado" data-ticket-source value="@Model.Chamado" placeholder="I2609-0223" autocomplete="off" />
                </div>
            </div>
            <div class="field compact-field source-field">
                <label>Fonte</label>
                <input value="@Model.Fonte" readonly />
            </div>
            <button type="submit" class="btn btn-primary">Carregar TOPdesk</button>
        </form>
        <div class="source-extension-help">
            Para carregar chamados, a extensão <strong>Automind TOPdesk Bridge</strong> precisa estar instalada no navegador.
            <a href="/ajuda/extensao-topdesk.html" target="_blank" rel="noopener">Ver instalação</a>
        </div>
        <div class="topdesk-import-status" data-topdesk-status hidden></div>
    </section>

    <form class="provisioning-grid"
          data-provisioning-form
          data-groups-url='@Url.Action("BuscarGrupos", "Colaboradores")'
          data-manual-groups-url='@Url.Action("BuscarOutrosGrupos", "Colaboradores")'
          data-validation-url='@Url.Action("ValidarAd", "Colaboradores")'
          data-create-url='@Url.Action("CriarUsuarioPiloto", "Colaboradores")'
          data-m365-license-url='@Url.Action("AplicarLicencasMicrosoft365", "Colaboradores")'
          data-pilot-membership-url='@Url.Action("AplicarMembershipPiloto", "Colaboradores")'
          data-write-enabled="@writeMode.ToString().ToLowerInvariant()"
          data-write-target-ou="@writeTargetOu"
          data-group-writes-enabled="@groupWritesEnabled.ToString().ToLowerInvariant()"
          data-m365-license-writes-enabled="@microsoft365LicenseWritesEnabled.ToString().ToLowerInvariant()"
          data-m365-sync-poll-seconds="@microsoft365SyncPollSeconds"
          data-m365-sync-max-wait-seconds="@microsoft365SyncMaxWaitSeconds">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Chamado" value="@Model.Chamado" />
        <input type="hidden" name="PerfilUsuario" value="@Model.PerfilUsuario" />
        <input type="hidden" name="GrupoTrabalho" value="@Model.GrupoTrabalho" />

        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">01</div>
                <div><span class="eyebrow">IDENTIFICAÇÃO</span><h2>Dados do colaborador</h2></div>
            </div>

            <div class="field"><label>Nome completo</label><input name="NomeCompleto" value="@Model.NomeCompleto" /></div>
            <div class="field"><label>Nome de guerra <small>exatamente 2 nomes</small></label><input name="NomeGuerra" value="@Model.NomeGuerra" /></div>
            <div class="form-row-2">
                <div class="field login-field" data-login-field>
                    <label>Login <small>máx. 20 caracteres no AD</small></label>
                    <input name="Login" value="@Model.Login" maxlength="20" data-samaccountname aria-describedby="loginLengthHelp loginLengthWarning" />
                    <div class="field-help-row" id="loginLengthHelp">
                        <span class="field-help">sAMAccountName do Active Directory: limite máximo de 20 caracteres.</span>
                        <span class="field-counter" data-login-counter>0 / 20</span>
                    </div>
                    <div class="field-warning" id="loginLengthWarning" data-login-length-warning hidden></div>
                </div>
                <div class="field"><label>E-mail corporativo</label><input name="Email" value="@Model.Email" /></div>
            </div>
            <div class="form-row-2">
                <div class="field">
                    <label>Telefone celular <small>formato: (71) 9 8169-6721</small></label>
                    <input name="TelefoneCelular"
                           value="@Model.TelefoneCelular"
                           data-phone-br
                           inputmode="numeric"
                           autocomplete="tel"
                           maxlength="16"
                           placeholder="(71) 9 8169-6721" />
                </div>
                <div class="field"><label>Local de trabalho</label><input name="LocalTrabalho" value="@Model.LocalTrabalho" /></div>
            </div>
            <label class="toggle-line">
                <input name="DivulgarContato" type="checkbox" checked="@Model.DivulgarContato" />
                <span class="toggle-ui"></span>
                <span><strong>Divulgar contato na intranet</strong><small>O telefone só será gravado no AD quando esta opção estiver ativa.</small></span>
            </label>
        </section>

        <section class="panel form-section">
            <div class="section-title-row">
                <div class="section-number">02</div>
                <div><span class="eyebrow">ORGANIZAÇÃO</span><h2>Cargo e estrutura</h2></div>
            </div>

            <div class="field"><label>Cargo em português</label><input name="CargoPortugues" value="@Model.CargoPortugues" /></div>
            <div class="field"><label>Cargo em inglês</label><input name="CargoIngles" value="@Model.CargoIngles" /></div>
            <div class="form-row-2">
                <div class="field"><label>Departamento</label><input name="Departamento" value="@Model.Departamento" /></div>
                <div class="field"><label>Empresa</label><input name="Empresa" value="Automind" readonly /></div>
            </div>
            <div class="field"><label>Superior imediato</label><input name="SuperiorImediato" value="@Model.SuperiorImediato" /></div>
            <div class="field">
                <label>OU de destino</label>
                <select name="OuDistinguishedName">
                    <option value="">Selecione uma OU...</option>
                    @foreach (var ou in ous)
                    {
                        <option value="@ou.DistinguishedName" selected="@(string.Equals(Model.OuSelecionada, ou.DistinguishedName, StringComparison.OrdinalIgnoreCase))">@ou.DisplayName</option>
                    }
                </select>
                <small class="field-help">Opções consultadas no AD real e filtradas pela allowlist de leitura. A escrita possui allowlist separada.</small>
            </div>
        </section>

        <section class="panel access-panel span-full">
            <div class="access-heading">
                <div>
                    <span class="eyebrow">03 · ACESSOS</span>
                    <h2>Sugestão automática pelo cargo</h2>
                    <p>A aplicação consulta usuários ativos com o mesmo cargo + departamento e calcula a frequência dos grupos diretos <code>memberOf</code>.</p>
                </div>
                <div class="access-tools">
                    <button type="button" class="btn btn-secondary" data-search-groups>Buscar grupos no AD</button>
                    <button type="button" class="btn btn-secondary" disabled title="A busca por colaborador de referência será habilitada em etapa posterior.">Colaborador de referência</button>
                </div>
            </div>

            <div class="empty-state" data-groups-empty hidden="@(Model.GruposSugeridos.Count > 0)">
                <span class="empty-state-icon">◎</span>
                <div><strong>Nenhuma sugestão carregada</strong><p>Informe cargo em inglês e departamento e clique em Buscar grupos no AD.</p></div>
            </div>

            <div class="access-summary" data-groups-summary hidden="@(Model.GruposSugeridos.Count == 0)">
                <div><strong data-common-count>@commonCount</strong><span>comuns ao cargo</span></div>
                <div><strong data-exception-count>@exceptionCount</strong><span>exceções encontradas</span></div>
                <div><strong data-protected-count>@protectedCount</strong><span>grupos protegidos</span></div>
            </div>
            <div class="table-wrap" data-groups-table hidden="@(Model.GruposSugeridos.Count == 0)">
                <table class="access-table">
                    <thead><tr><th></th><th>Grupo</th><th>Incidência</th><th>Classificação</th></tr></thead>
                    <tbody data-groups-body>
                    @if (commonGroups.Count > 0)
                    {
                        <tr class="group-section-row"><td colspan="4">Grupos comuns ao cargo</td></tr>
                        @foreach (var g in commonGroups)
                        {
                            <tr class="row-common">
                                <td><input class="group-checkbox" type="checkbox" value="@g.DistinguishedName" checked="@g.Selecionado" /></td>
                                <td>
                                    <strong>@g.Nome</strong>
                                    <small class="group-meta">@g.Categoria · @g.Escopo</small>
                                    @if (g.EfeitosIndiretos.Count > 0)
                                    {
                                        <small class="group-indirect">Acesso indireto: @string.Join(", ", g.EfeitosIndiretos)</small>
                                    }
                                </td>
                                <td><span class="incidence">@g.EncontradoEm / @g.TotalComparados</span></td>
                                <td><span class="status-pill status-pill-success">Comum ao cargo</span></td>
                            </tr>
                        }
                    }
                    @if (exceptionGroups.Count > 0)
                    {
                        <tr class="group-section-row"><td colspan="4">Exceções encontradas</td></tr>
                        @foreach (var g in exceptionGroups)
                        {
                            <tr>
                                <td><input class="group-checkbox" type="checkbox" value="@g.DistinguishedName" checked="@g.Selecionado" /></td>
                                <td>
                                    <strong>@g.Nome</strong>
                                    <small class="group-meta">@g.Categoria · @g.Escopo</small>
                                    @if (g.EfeitosIndiretos.Count > 0)
                                    {
                                        <small class="group-indirect">Acesso indireto: @string.Join(", ", g.EfeitosIndiretos)</small>
                                    }
                                </td>
                                <td><span class="incidence">@g.EncontradoEm / @g.TotalComparados</span></td>
                                <td><span class="status-pill">Exceção</span></td>
                            </tr>
                        }
                    }
                    @if (protectedGroups.Count > 0)
                    {
                        <tr class="group-section-row"><td colspan="4">Grupos protegidos</td></tr>
                        @foreach (var g in protectedGroups)
                        {
                            <tr class="row-protected">
                                <td><input class="group-checkbox" type="checkbox" value="@g.DistinguishedName" disabled /></td>
                                <td>
                                    <strong>@g.Nome</strong>
                                    <small class="group-meta">@g.Categoria · @g.Escopo</small>
                                    @if (g.EfeitosIndiretos.Count > 0)
                                    {
                                        <small class="group-indirect">Acesso indireto: @string.Join(", ", g.EfeitosIndiretos)</small>
                                    }
                                </td>
                                <td><span class="incidence">@g.EncontradoEm / @g.TotalComparados</span></td>
                                <td><span class="status-pill status-pill-danger">Protegido</span></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            <div class="manual-groups-panel">
                <div class="manual-groups-heading">
                    <div>
                        <h3>Outros grupos</h3>
                        <p>Digite o nome de um grupo existente no AD para adicionar manualmente quando ele não aparecer nas sugestões.</p>
                    </div>
                </div>
                <div class="manual-group-search">
                    <input type="text" data-manual-group-query autocomplete="off" placeholder="Ex.: _Internet, Dist_Todos..." />
                    <button type="button" class="btn btn-secondary" data-search-manual-groups>Buscar no AD</button>
                </div>
                <div class="manual-group-results" data-manual-group-results hidden></div>
                <div class="manual-group-selected" data-manual-group-selected hidden>
                    <strong>Adicionados manualmente</strong>
                    <div data-manual-group-chips></div>
                </div>
                <div class="topdesk-import-status" data-manual-groups-status hidden></div>
            </div>

            @if (!groupWritesEnabled)
            {
                <div class="topdesk-import-status is-warning group-write-warning">Os grupos comuns ao cargo permanecem marcados como sugestão e as exceções ficam desmarcadas. Enquanto GroupWritesEnabled=false, essas seleções são apenas informativas e o usuário não será adicionado a nenhum grupo.</div>
            }
            else
            {
                <div class="topdesk-import-status is-warning group-write-warning">Piloto de memberships ativo. Somente grupos presentes na allowlist de escrita podem permanecer selecionados na pré-validação.</div>
            }
            <div class="topdesk-import-status" data-groups-status hidden></div>
        </section>


        <section class="panel span-full license-panel">
            <div class="license-heading">
                <div>
                    <span class="eyebrow">04 · MICROSOFT 365</span>
                    <h2>Licenças disponíveis</h2>
                    <p>Inventário consultado no Microsoft Graph. Selecione as licenças disponíveis que deverão ser atribuídas após a sincronização do novo usuário com o Entra.</p>
                </div>
                <span class="status-pill @(microsoft365Healthy ? "status-pill-success" : (!string.IsNullOrWhiteSpace(microsoft365Error) ? "status-pill-danger" : string.Empty))">@(microsoft365Healthy ? "Graph conectado" : (!string.IsNullOrWhiteSpace(microsoft365Error) ? "Falha na consulta" : "Desativado"))</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(microsoft365Error))
            {
                <div class="topdesk-import-status is-error license-status">@microsoft365Error</div>
            }
            else if (!microsoft365Enabled)
            {
                <div class="empty-state license-empty">
                    <span class="empty-state-icon">◎</span>
                    <div><strong>Inventário Microsoft 365 desativado</strong><p>Ative a configuração somente quando a identidade App-only estiver pronta no servidor.</p></div>
                </div>
            }
            else if (microsoft365Licenses.Count == 0)
            {
                <div class="empty-state license-empty">
                    <span class="empty-state-icon">◎</span>
                    <div><strong>Nenhuma licença retornada</strong><p>O Microsoft Graph respondeu sem SKUs para exibição.</p></div>
                </div>
            }
            else
            {
                <div class="license-list">
                    @foreach (var license in microsoft365Licenses)
                    {
                        var canSelectLicense = microsoft365LicenseWritesEnabled && license.CanAssign;
                        <div class="license-row @(license.IsSuspended ? "is-suspended" : string.Empty)" data-license-row data-sku-id="@license.SkuId" data-available-units="@license.AvailableUnits" data-enabled-units="@license.EnabledUnits">
                            <div class="license-selector">
                                <input type="checkbox"
                                       class="license-checkbox"
                                       value="@license.SkuId"
                                       data-license-name="@license.DisplayName"
                                       disabled="@(!canSelectLicense)"
                                       title="@(canSelectLicense ? $"Selecionar {license.DisplayName}" : "Licença indisponível para seleção nesta operação.")" />
                            </div>
                            <div class="license-copy">
                                <strong>@license.DisplayName</strong>
                                @if (license.IsSuspended)
                                {
                                    <span data-license-count>Assinatura suspensa</span>
                                }
                                else if (!license.IsEnabled)
                                {
                                    <span data-license-count>Status da assinatura: @license.CapabilityStatus</span>
                                }
                                else if (license.IsUnlimited)
                                {
                                    <span data-license-count>Licenças ilimitadas disponíveis</span>
                                }
                                else
                                {
                                    <span data-license-count><b>@license.AvailableUnits</b> de @license.EnabledUnits licenças disponíveis</span>
                                }
                                <small>@license.SkuPartNumber</small>
                            </div>
                            <div class="license-state" data-license-state>
                                @if (license.IsSuspended)
                                {
                                    <span class="status-pill status-pill-danger">Suspensa</span>
                                }
                                else if (!license.IsEnabled)
                                {
                                    <span class="status-pill status-pill-danger">Indisponível</span>
                                }
                                else if (!license.IsUnlimited && license.AvailableUnits == 0)
                                {
                                    <span class="status-pill status-pill-danger">Sem vagas</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill-success">Disponível</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (!microsoft365LicenseWritesEnabled)
                {
                    <div class="license-readonly-note">Seleção desabilitada por configuração. O inventário permanece somente leitura.</div>
                }
                else
                {
                    <div class="license-readonly-note">A seleção é revalidada no backend. Após criar o usuário no AD, o sistema aguarda o Cloud Sync e atribui somente os SKUs selecionados. Em falha, remove apenas as licenças adicionadas pela operação.</div>
                    <div class="topdesk-import-status" data-m365-provision-status hidden></div>
                    <button type="button" class="btn btn-secondary btn-small license-retry" data-retry-m365 hidden>Repetir atribuição M365</button>
                }
            }
        </section>

        <section class="panel validation-panel span-full">
            <div class="validation-copy">
                <span class="eyebrow">05 · PRÉ-VALIDAÇÃO</span>
                <h2>Validar AD + Microsoft 365</h2>
                <p>Revalida chamado, identidade, superior, OU, grupos e as licenças Microsoft 365 selecionadas diretamente no backend.</p>
            </div>
            <div class="validation-checks">
                <span data-ad-check="ticket">○ Chamado TOPdesk válido</span>
                <span data-ad-check="name">○ Nome completo válido</span>
                <span data-ad-check="login">○ Login válido e disponível</span>
                <span data-ad-check="cn">○ CN disponível na OU</span>
                <span data-ad-check="upn">○ UPN disponível</span>
                <span data-ad-check="email">○ E-mail / SMTP disponível</span>
                <span data-ad-check="organization">○ Cargo e departamento preenchidos</span>
                <span data-ad-check="manager">○ Superior localizado</span>
                <span data-ad-check="ou">○ OU válida</span>
                <span data-ad-check="groups">○ Grupos válidos</span>
                <span data-ad-check="licenses">○ Licenças Microsoft 365 válidas</span>
            </div>
            <div class="validation-actions">
                <button type="button" class="btn btn-primary btn-wide" data-validate-ad>Validar AD + M365 <small>somente leitura</small></button>
            </div>
            <div class="topdesk-import-status validation-status" data-validation-status hidden></div>
        </section>

        <section class="panel span-full ad-preview" data-ad-preview hidden>
            <div class="section-title-row">
                <div class="section-number">06</div>
                <div><span class="eyebrow">PRÉVIA</span><h2>Objeto preparado para o AD</h2></div>
            </div>
            <p class="preview-warning"><strong>A prévia não executa escrita.</strong> proxyAddresses e pwdLastSet permanecem fora do contrato do piloto.</p>
            <dl class="preview-grid">
                <div><dt>CN</dt><dd data-preview="cn"></dd></div>
                <div><dt>sAMAccountName</dt><dd data-preview="samAccountName"></dd></div>
                <div><dt>givenName</dt><dd data-preview="givenName"></dd></div>
                <div><dt>sn</dt><dd data-preview="surname"></dd></div>
                <div><dt>UPN</dt><dd data-preview="userPrincipalName"></dd></div>
                <div><dt>mail</dt><dd data-preview="mail"></dd></div>
                <div><dt>description</dt><dd data-preview="description"></dd></div>
                <div><dt>SMTP futuro (não escrito)</dt><dd data-preview="primarySmtp"></dd></div>
                <div><dt>SMTP secundário futuro (não escrito)</dt><dd data-preview="secondarySmtp"></dd></div>
                <div><dt>Title</dt><dd data-preview="title"></dd></div>
                <div><dt>Department</dt><dd data-preview="department"></dd></div>
                <div><dt>Company</dt><dd data-preview="company"></dd></div>
                <div><dt>Office</dt><dd data-preview="office"></dd></div>
                <div><dt>Telephone</dt><dd data-preview="telephoneNumber"></dd></div>
                <div class="preview-wide"><dt>Manager DN</dt><dd data-preview="managerDistinguishedName"></dd></div>
                <div class="preview-wide"><dt>OU DN</dt><dd data-preview="ouDistinguishedName"></dd></div>
                <div class="preview-wide"><dt>@(groupWritesEnabled ? "Grupos selecionados" : "Grupos sugeridos/selecionados (não escritos)")</dt><dd data-preview="groups"></dd></div>
                <div class="preview-wide"><dt>Licenças Microsoft 365 selecionadas</dt><dd data-preview="licenses"></dd></div>
            </dl>
        </section>

        @if (writeMode)
        {
            <section class="panel span-full pilot-write-panel" data-pilot-write>
                <div class="section-title-row">
                    <div class="section-number">07</div>
                    <div><span class="eyebrow">PILOTO CONTROLADO</span><h2>Criar usuário no AD</h2></div>
                </div>
                <div class="pilot-scope">
                    <strong>Escopo de escrita:</strong>
                    <code>@writeTargetOu</code>
                </div>
                <p>O backend reexecuta todas as validações imediatamente antes da escrita. A conta nasce desabilitada, recebe atributos, senha, manager e memberships autorizadas, é relida e habilitada. Se houver licenças selecionadas, a tela aguarda a sincronização com o Entra e aplica UsageLocation=BR + licenças com readback e rollback específico. proxyAddresses e pwdLastSet permanecem fora do contrato.</p>
                <button type="button" class="btn btn-primary btn-wide" data-create-user disabled>Criar usuário piloto no AD</button>
                <div class="topdesk-import-status" data-create-status hidden></div>
                <div class="temporary-password" data-temporary-password hidden>
                    <strong>Senha inicial — exibição única</strong>
                    <code data-password-value></code>
                    <button type="button" class="btn btn-secondary" data-copy-password>Copiar senha</button>
                    <small>Não registrar esta senha em histórico, banco, ticket ou log.</small>
                </div>
            </section>
        }

            @if (pilotMembershipTestEnabled)
            {
                <section class="panel span-full pilot-write-panel" data-pilot-membership>
                    <div class="section-title-row">
                        <div class="section-number">08</div>
                        <div><span class="eyebrow">MEMBERSHIP PILOTO</span><h2>Adicionar usuário existente ao grupo autorizado</h2></div>
                    </div>
                    <p><strong>Usuário:</strong> <code>@pilotMembershipUserDn</code></p>
                    <p><strong>Grupo:</strong> <code>@pilotMembershipGroupDn</code></p>
                    <p>Este teste altera somente a associação acima e valida o resultado por releitura do atributo <code>member</code> do grupo.</p>
                    <button type="button" class="btn btn-primary btn-wide" data-apply-pilot-membership>Aplicar membership piloto</button>
                    <div class="topdesk-import-status" data-pilot-membership-status hidden></div>
                </section>
            }
    </form>
</div>
