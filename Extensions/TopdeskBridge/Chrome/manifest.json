{
  "manifest_version": 3,
  "name": "Automind TOPdesk Bridge - Chrome",
  "version": "1.0.2",
  "description": "Ponte de leitura do TOPdesk para o sistema Automind Cadastro de Colaboradores usando a sessão já autenticada do operador.",
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": [
    "https://automind.topdesk.net/*",
    "http://cadastro.automind.com.br/*",
    "https://cadastro.automind.com.br/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://cadastro.automind.com.br/*",
        "https://cadastro.automind.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Automind TOPdesk Bridge - Chrome",
    "default_popup": "popup.html"
  }
}
